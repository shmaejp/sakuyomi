{
	"permissions": {
		"deny": [
			"Read(**/.env)",
			"Read(**/.env.local)",
			"Read(**/.env.*.local)",
			"Read(**/.env.development)",
			"Read(**/.env.production)",
			"Read(**/.env.test)",
			"Read(**/.env.keys)"
		]
	},
	"hooks": {
		"PreToolUse": [
			{
				"matcher": "Bash|PowerShell|Read|Grep|Glob|Edit|Write|MultiEdit",
				"hooks": [
					{
						"type": "command",
						"command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/protect-env.mjs\""
					}
				]
			}
		],
		"PostToolUse": [
			{
				"matcher": "Write|Edit|MultiEdit",
				"hooks": [
					{
						"type": "command",
						"command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/format.mjs\""
					}
				]
			}
		]
	}
}
