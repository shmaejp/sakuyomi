#!/bin/sh
# commit 前に Linter・型チェック・テストを走らせ、失敗したら commit を止める。
set -e

if [ ! -x node_modules/.bin/biome ]; then
	echo "pre-commit: Biome が見つかりません。npm install を実行してください。" >&2
	exit 1
fi

echo "pre-commit: Biome（lint・書式）を確認しています..."
node_modules/.bin/biome check --no-errors-on-unmatched .

# 型チェックは tsconfig.json と TypeScript がそろっているときだけ行う。
if [ -f tsconfig.json ] && [ -x node_modules/.bin/tsc ]; then
	echo "pre-commit: tsc --noEmit で型を確認しています..."
	node_modules/.bin/tsc --noEmit
else
	echo "pre-commit: tsconfig.json または TypeScript がないため、型チェックを省略します。"
fi

# テストは Vitest があるときだけ行う。DB のテストは、ローカルの Supabase が起動しているときだけ行う。
if [ -x node_modules/.bin/vitest ]; then
	echo "pre-commit: Vitest（unit）を走らせています..."
	node_modules/.bin/vitest run --project unit --passWithNoTests
	if node_modules/.bin/supabase status >/dev/null 2>&1; then
		echo "pre-commit: Vitest（db）を走らせています..."
		node_modules/.bin/vitest run --project db
	else
		echo "pre-commit: ローカルの Supabase が起動していないため、DB のテストを省略します（npm run db:start）。"
	fi
fi
